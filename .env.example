# Goldfish Lab - local environment template.
# Copy to .env and fill in, or run:  python scripts/bootstrap_env.py
# .env is gitignored and must NEVER be committed.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=goldfishlab.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# docker compose reads POSTGRES_* to create the database; Django reads
# DATABASE_URL. Keep the credentials in the two consistent.
POSTGRES_DB=goldfishlab
POSTGRES_USER=goldfishlab
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://goldfishlab:replace-me@127.0.0.1:5432/goldfishlab

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Scryfall -------------------------------------------------------------
# Scryfall asks every client to identify itself. Both this header and Accept
# are mandatory: without them the API answers HTTP 400.
SCRYFALL_USER_AGENT=GoldfishLab/0.1 (+https://goldfishlab.app)

# --- Stripe ---------------------------------------------------------------
# Leave these empty for local work. With no secret key the application says
# "billing is not configured yet" on the plans page and offers nothing to buy,
# which is what every test and every screenshot run sees.
#
# The webhook secret belongs to ONE endpoint. `stripe listen --forward-to
# localhost:8000/billing/webhook/` prints a different one from the dashboard's,
# and mixing them up fails every signature check.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Managed Payments (Stripe as merchant of record, handles VAT). Only
# true once Stripe's eligibility review approved the account - Checkout rejects
# the parameter before that. Also switches the terms, privacy and plans pages
# to "sold through Link". The operator's notes hold the steps.
STRIPE_MANAGED_PAYMENTS=false
# Round prices per currency (CHF / EUR / USD by the visitor's country, from
# Cloudflare's CF-IPCountry header). Needs a Stripe price per plan with
# currency_options for chf, eur and usd. Off until Managed Payments is approved
# and an EU representative is appointed (a legal decision, see the notes).
LOCAL_PRICES=false
# Languages switched on besides English (phase 12), comma-separated, from
# de, fr, it, es, pt-br, ja. Empty = English only. Production: all six (the
# operator's notes list the legal points that come with es, pt-br and ja).
LANGUAGES_ON=

# --- Mistral --------------------------------------------------------------
# The deck summary's written part (phase 10 H): feel, strengths, weaknesses
# and tactics, written once per deck version and reused until the deck changes.
# Blank disables it - nothing is written, nothing is charged, and the summary
# block shows only its computed "Mechanisms".
#
# **Mistral, decided 2026-09-20** - a European project on European
# infrastructure, which also keeps card text and user decks inside the EU and
# makes the GDPR story a paragraph rather than a transfer assessment. Only card
# names, categories and numbers are sent, never anything about the person.
#
# Production needs it on the web node AND on worker-short, which writes the
# summaries. Put the real key in your own .env - never here, never in the
# repository, never in a chat.
MISTRAL_API_KEY=
# The model. Chosen by F7 (docs/phases/phase-10-test-findings.md).
MISTRAL_MODEL=mistral-medium-2604
# Load protection: summaries started per day (Europe/Zurich), and how many of
# them guests may take. Reaching the ceiling pauses summaries until midnight;
# nobody is charged for one that is not written. The operator gets a mail at
# 80 %.
SUMMARIES_PER_DAY=200
GUEST_SUMMARIES_PER_DAY=100

# --- Email (Phase 8) --------------------------------------------------------
# NOT optional in production, and this is the one setting whose absence breaks
# a feature rather than degrading it. `ACCOUNT_EMAIL_VERIFICATION` is
# "mandatory", so allauth sends a confirmation during signup - with no mail
# host, Django's default SMTP backend dials localhost:25, which is not there,
# and the signup form answers HTTP 500.
#
# Invisible everywhere it would be cheap to catch: development uses the console
# backend, the test runner substitutes locmem, and the whole suite passes. So
# `core/checks.py` refuses to let production BOOT without these rather than
# letting it serve a broken signup. See trap 43.
#
# Locally, leave them alone: dev.py prints mail to the console.
# DJANGO_EMAIL_HOST=mail.infomaniak.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# STARTTLS on 587. Implicit TLS on 465 is DJANGO_EMAIL_USE_SSL instead - the
# two are mutually exclusive and setting both fails to send, naming neither.
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# A real mailbox on the sending domain, or SPF/DKIM will not line up and a
# mandatory confirmation lands in spam, which looks exactly like broken.
# DJANGO_DEFAULT_FROM_EMAIL=Goldfish Lab <noreply@goldfishlab.app>
# Set this to the console backend to run production deliberately without mail;
# it is what switches the boot-time check off. The default is Django's SMTP
# backend with a Message-ID on the From domain (core/mail.py).
# DJANGO_EMAIL_BACKEND=core.mail.EmailBackend
# Who hears about failed runs, a stuck queue or a failed nightly card job
# (phase 12 J12, core/alerts.py; at most one mail per kind a day). Empty: a log
# line instead. Production sets it on worker-short, the node whose beat runs
# the check, and that node then needs the SMTP settings above as well.
ALERT_EMAIL=

# --- The operator, for the legal pages -----------------------------------------
# Who runs this installation. The terms, the privacy policy and /imprint/ render
# these three; production refuses to boot while any is blank (core.E003),
# because the Swiss DSG (Art. 19) and UWG (Art. 3 lit. s) require a name, a
# postal address and an email. Environment rather than template text so a home
# address never enters the repository. The address is comma separated, one
# rendered line per entry. Locally they may stay blank: the pages then say
# "Not configured in this installation".
# LEGAL_OPERATOR_NAME=Erika Muster
# LEGAL_OPERATOR_ADDRESS=Musterstrasse 1, 8000 Zürich, Switzerland
# LEGAL_CONTACT_EMAIL=hello@goldfishlab.app

# --- Source code (AGPL-3.0) --------------------------------------------------
# The public repository of THIS installation. The footer links it ("Source
# code") and its issue tracker ("Report a problem"); blank hides both. The
# licence asks anyone running a modified copy as a website to offer its users
# the source - a fork points this at its own repository.
# SOURCE_CODE_URL=https://github.com/Riddmaker/goldfishlab.app

# --- The site's one address (P3) ---------------------------------------------
# What canonical links, Open Graph tags, the sitemap and robots.txt name, so a
# page reached on www. or on the hoster's own domain still points at the real
# address. http(s)://host, no path, no trailing slash. Blank uses the host of
# the request, which is right locally; production warns without it (core.W001).
# SITE_URL=https://goldfishlab.app

# --- Sentry (Phase 8) -------------------------------------------------------
# NOT set at launch. Sentry is a processor the privacy policy does not name
# (it says "no error-reporting service"): name it in
# templates/core/privacy.html - who, what, which country - BEFORE a DSN goes in.
# Empty means OFF, and off is the default everywhere but production. The
# `sentry_sdk` import in goldfishlab/settings/prod.py sits INSIDE the
# `if SENTRY_DSN:` branch, so an installation without a DSN does not pay for
# the integrations either - development, CI and the test suite all run with
# this blank and nothing mocked.
#
# It is never set in a local .env. A crash on somebody's laptop is not an
# incident, and sending it would put a developer's own decks into a hosted
# error tracker.
SENTRY_DSN=
# A share of requests, not all of them. Tracing every simulation enqueue on a
# 128 MiB cloudlet buys noise and costs memory.
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_ENVIRONMENT=production

# --- Production only ------------------------------------------------------
# Set in the Jelastic environment, never here.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://goldfishlab.app,https://www.goldfishlab.app
# DJANGO_SECURE_SSL_REDIRECT=True
#
# HSTS, in seconds. Defaults to one year when unset, which is what production
# should run. It is an environment variable for exactly one situation: a FIRST
# deploy onto a hostname whose certificate is not settled yet, where a browser
# that has seen the header will refuse plain HTTP to that host for a year and
# there is no way to call it back. Start at 0, prove the certificate, turn it
# up.
# DJANGO_HSTS_SECONDS=31536000
#
# Reverse proxies in front of the app that append to X-Forwarded-For. Both rate
# limiters - allauth's (login, signup, password reset) and this project's own -
# count the address this many entries from the right. 1 is the Jelastic
# topology; add one per CDN put in front; 0 means no proxy at all. Wrong in
# either direction and the limits break: too low and every visitor shares the
# proxy's bucket, too high and a client can forge a fresh address per request.
# DJANGO_TRUSTED_PROXY_COUNT=1
