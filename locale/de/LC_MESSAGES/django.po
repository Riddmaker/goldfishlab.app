msgstr "ein %(color)s pro basic %(type)s, den du kontrollierst"

#: simulations/engine/adapter.py
#, python-format
msgid "one %(color)s for each %(dead)s creature card in your graveyard"
msgstr "ein %(color)s pro %(dead)s Kreaturenkarte in deinem Friedhof"

#: simulations/engine/adapter.py
msgid "as much as your devotion to your best colour, in that colour"
msgstr ""
"so viel wie deine Ergebenheit zu deiner stärksten Farbe, in dieser Farbe"

