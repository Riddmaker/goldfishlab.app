#: cards/profiles.py
msgid "enters tapped only conditionally ('unless')"
msgstr "entra girada solo bajo condición («unless»)"

#: cards/profiles.py
msgid "text mentions entering tapped, but the condition was not readable"
msgstr "el texto menciona que entra girada, pero la condición no se pudo leer"

#: cards/profiles.py
msgid "a mana ability with a coloured cost (a filter) is not modelled"
msgstr "no se modela una habilidad de maná con coste de color (un filtro)"

#: cards/profiles.py
msgid "makes a kind of mana the engine does not model"
msgstr "produce un tipo de maná que el motor no modela"

#: cards/profiles.py
msgid "the part of its mana that grows with the board is not counted"
msgstr "no se cuenta la parte de su maná que crece con el tablero"

#: cards/profiles.py
msgid "mana amount scales with the board"
msgstr "la cantidad de maná crece con el tablero"

#: cards/profiles.py
msgid "a conditional replacement ('instead') is not counted"
msgstr "no se cuenta un reemplazo condicional («instead»)"

#: cards/profiles.py
msgid "needs an opponent's lands; a goldfish has none"
msgstr "necesita las tierras de un oponente; un goldfish no tiene ninguna"

#: cards/profiles.py
msgid "an 'Add' clause whose amount could not be read"
msgstr "una cláusula «Add» cuya cantidad no se pudo leer"

#: cards/profiles.py
msgid "makes mana only from a triggered or static ability"
msgstr "produce maná solo con una habilidad disparada o estática"

#: cards/profiles.py
msgid "makes mana only as part of another effect"
msgstr "produce maná solo como parte de otro efecto"

#: cards/profiles.py
msgid "its mana is restricted to certain spells or moments"
msgstr "su maná está restringido a ciertos hechizos o momentos"

#: cards/profiles.py
msgid "enters only by discarding a land card, which the engine does not do"
msgstr "entra solo descartando una carta de tierra, algo que el motor no hace"

#: cards/profiles.py
msgid "only grants a mana ability to another permanent"
msgstr "solo otorga una habilidad de maná a otro permanente"

#: cards/profiles.py
msgid "produces mana, but no readable 'Add' clause"
msgstr "produce maná, pero sin una cláusula «Add» legible"

#: cards/profiles.py
msgid "an ability that only converts mana is not modelled"
msgstr "no se modela una habilidad que solo convierte maná"

#: cards/profiles.py
msgid "sacrifices itself for mana, which is not modelled on a creature"
msgstr ""
"se sacrifica para producir maná, algo que no se modela en una criatura"

#: cards/profiles.py
msgid "its mana ability costs as much as it makes"
msgstr "su habilidad de maná cuesta tanto como produce"

#: cards/profiles.py
msgid "searches the library more than once; not modelled"
msgstr "busca en la biblioteca más de una vez; no se modela"

#: cards/profiles.py
msgid "tutors, but no readable 'search your library' clause"
msgstr "es un tutor, pero sin una cláusula «search your library» legible"

#: cards/profiles.py
msgid "tutors, but to which zone could not be read"
msgstr "es un tutor, pero no se pudo leer a qué zona"

#: cards/profiles.py
msgid "tutors to more than one zone; not modelled"
msgstr "es un tutor hacia más de una zona; no se modela"

#: cards/profiles.py
msgid "tutors onto the battlefield, which the engine cannot do"
msgstr ""
"es un tutor directo al campo de batalla, algo que el motor no puede hacer"

#: cards/profiles.py
msgid "tutors for something the engine cannot describe"
msgstr "busca algo que el motor no sabe describir"

#: cards/profiles.py
msgid "tutors for more than one card kind; not modelled"
msgstr "busca más de un tipo de carta; no se modela"

#: cards/profiles.py
msgid "searches, then discards at random; the discard is not modelled"
msgstr "busca y luego descarta al azar; el descarte no se modela"

#: cards/profiles.py
msgid "tutors, but how many cards it finds could not be read"
msgstr "es un tutor, pero no se pudo leer cuántas cartas encuentra"

#: cards/profiles.py
msgid "tagged as adding more than one mana; only one was read"
msgstr "etiquetada como que añade más de un maná; solo se leyó uno"

#: cards/profiles.py
msgid "has an additional casting cost the engine does not pay"
msgstr "tiene un coste adicional de lanzamiento que el motor no paga"

#: cards/profiles.py
msgid "hybrid pips: payment flexibility is not modelled"
msgstr "manás híbridos: la flexibilidad de pago no se modela"

#: cards/profiles.py
msgid "cost contains X"
msgstr "el coste contiene X"

#: combos/measure.py
msgid ""
"No timing for this one: it needs a kind of card rather than a named one, "
"which is a search and not a simulation."
msgstr ""
"Sin tiempos para este: necesita un tipo de carta en lugar de una carta "
"concreta, y eso es una búsqueda, no una simulación."

#: combos/measure.py
msgid ""
"No timing for this one: it names a card this application has not got in its "
"catalogue."
msgstr ""
"Sin tiempos para este: nombra una carta que esta aplicación no tiene en su "
"catálogo."

#: combos/measure.py
msgid ""
"No timing for this one: it asks for a card to be somewhere this simulator "
"does not model."
msgstr ""
"Sin tiempos para este: pide que una carta esté en un lugar que este "
"simulador no modela."

#: combos/measure.py
msgid ""
"No timing for this one: it is more than one card away once this deck is read"
" our way."
msgstr ""
"Sin tiempos para este: le falta más de una carta en este mazo, leído a "
"nuestra manera."

#: combos/measure.py
msgid ""
"No timing for this one: it is one this deck turns out not to hold, once it "
"is read our way."
msgstr ""
"Sin tiempos para este: resulta que este mazo no lo contiene, leído a nuestra"
" manera."

#: combos/measure.py
msgid ""
"No timing for this one: it was not among the most-played few this run had "
"room to measure."
msgstr ""
"Sin tiempos para este: no estaba entre los pocos más jugados que esta "
"simulación tuvo espacio para medir."

