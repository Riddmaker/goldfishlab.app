msgstr "ese archivo no es un CSV válido: %(error)s"

#: decks/importers/tabular.py
msgid ""
"that file is not a table - no line in it splits into columns consistently. "
"If it is a plain list of card names, choose 'Plain text list' as the format."
msgstr ""
"ese archivo no es una tabla: ninguna línea se divide en columnas de forma "
"coherente. Si es una lista simple de nombres de carta, elige «Lista de texto"
" simple» como formato."

