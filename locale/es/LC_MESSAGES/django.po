msgstr ""
"Importado de una lista pegada: <span class=\"tabular\">%(matched)s</span> de"
" <span class=\"tabular\">%(total)s</span> filas con coincidencia. <a "
"href=\"%(review_url)s\" class=\"underline\">Ver lo exacta que fue la "
"coincidencia</a>."

#: changelog/entries.py
msgid "A pasted list is no longer called a file"
msgstr "Una lista pegada ya no se llama archivo"

#: changelog/entries.py
msgid ""
"After you paste a deck list, the import review, the column check and the "
"deck page say “pasted list” where they said “uploaded file”, “your file” or "
"“imported from a file”."
