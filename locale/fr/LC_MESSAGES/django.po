#: cards/profiles.py
msgid "enters tapped only conditionally ('unless')"
msgstr "n'arrive engagé que sous condition (« unless »)"

#: cards/profiles.py
msgid "text mentions entering tapped, but the condition was not readable"
msgstr ""
"le texte parle d'arriver engagé, mais la condition n'a pas pu être lue"

#: cards/profiles.py
msgid "a mana ability with a coloured cost (a filter) is not modelled"
msgstr ""
"une capacité de mana avec un coût coloré (un filtre) n'est pas modélisée"

#: cards/profiles.py
msgid "makes a kind of mana the engine does not model"
msgstr "produit un type de mana que le moteur ne modélise pas"

#: cards/profiles.py
msgid "the part of its mana that grows with the board is not counted"
msgstr "la part de son mana qui augmente avec le plateau n'est pas comptée"

#: cards/profiles.py
msgid "mana amount scales with the board"
msgstr "la quantité de mana dépend du plateau"

#: cards/profiles.py
msgid "a conditional replacement ('instead') is not counted"
msgstr "un remplacement conditionnel (« instead ») n'est pas compté"

#: cards/profiles.py
msgid "needs an opponent's lands; a goldfish has none"
msgstr "a besoin des terrains d'un adversaire ; un goldfish n'en a pas"

#: cards/profiles.py
msgid "an 'Add' clause whose amount could not be read"
msgstr "une clause « Add » dont la quantité n'a pas pu être lue"

#: cards/profiles.py
msgid "makes mana only from a triggered or static ability"
msgstr "ne produit du mana que par une capacité déclenchée ou statique"

#: cards/profiles.py
msgid "makes mana only as part of another effect"
msgstr "ne produit du mana que dans le cadre d'un autre effet"

#: cards/profiles.py
msgid "its mana is restricted to certain spells or moments"
msgstr "son mana est limité à certains sorts ou certains moments"

#: cards/profiles.py
msgid "enters only by discarding a land card, which the engine does not do"
msgstr ""
"n'arrive qu'en défaussant une carte de terrain, ce que le moteur ne fait pas"

#: cards/profiles.py
msgid "only grants a mana ability to another permanent"
msgstr "donne seulement une capacité de mana à un autre permanent"

#: cards/profiles.py
msgid "produces mana, but no readable 'Add' clause"
msgstr "produit du mana, mais aucune clause « Add » lisible"

#: cards/profiles.py
msgid "an ability that only converts mana is not modelled"
msgstr "une capacité qui ne fait que convertir du mana n'est pas modélisée"

#: cards/profiles.py
msgid "sacrifices itself for mana, which is not modelled on a creature"
msgstr "se sacrifie pour du mana, ce qui n'est pas modélisé sur une créature"

#: cards/profiles.py
msgid "its mana ability costs as much as it makes"
msgstr "sa capacité de mana coûte autant qu'elle produit"

#: cards/profiles.py
msgid "searches the library more than once; not modelled"
msgstr "cherche dans la bibliothèque plus d'une fois ; non modélisé"

#: cards/profiles.py
msgid "tutors, but no readable 'search your library' clause"
msgstr "tutor, mais aucune clause « search your library » lisible"

#: cards/profiles.py
msgid "tutors, but to which zone could not be read"
msgstr "tutor, mais la zone de destination n'a pas pu être lue"

#: cards/profiles.py
msgid "tutors to more than one zone; not modelled"
msgstr "tutor vers plus d'une zone ; non modélisé"

#: cards/profiles.py
msgid "tutors onto the battlefield, which the engine cannot do"
msgstr ""
"tutor directement sur le champ de bataille, ce que le moteur ne sait pas "
"faire"

#: cards/profiles.py
msgid "tutors for something the engine cannot describe"
msgstr "tutor pour quelque chose que le moteur ne sait pas décrire"

#: cards/profiles.py
msgid "tutors for more than one card kind; not modelled"
msgstr "tutor pour plus d'un type de carte ; non modélisé"

#: cards/profiles.py
msgid "searches, then discards at random; the discard is not modelled"
msgstr "cherche, puis défausse au hasard ; la défausse n'est pas modélisée"

#: cards/profiles.py
msgid "tutors, but how many cards it finds could not be read"
msgstr "tutor, mais le nombre de cartes trouvées n'a pas pu être lu"

#: cards/profiles.py
msgid "tagged as adding more than one mana; only one was read"
msgstr "étiqueté comme produisant plus d'un mana ; un seul a été lu"

#: cards/profiles.py
msgid "has an additional casting cost the engine does not pay"
msgstr "a un coût de lancement supplémentaire que le moteur ne paie pas"

#: cards/profiles.py
msgid "hybrid pips: payment flexibility is not modelled"
msgstr "symboles hybrides : la souplesse de paiement n'est pas modélisée"

#: cards/profiles.py
msgid "cost contains X"
msgstr "le coût contient X"

#: combos/measure.py
msgid ""
"No timing for this one: it needs a kind of card rather than a named one, "
"which is a search and not a simulation."
msgstr ""
"Pas de timing pour celle-ci : elle demande un type de carte plutôt qu'une "
"carte précise, ce qui relève de la recherche et non de la simulation."

#: combos/measure.py
msgid ""
"No timing for this one: it names a card this application has not got in its "
"catalogue."
msgstr ""
"Pas de timing pour celle-ci : elle nomme une carte que cette application n'a"
" pas dans son catalogue."

#: combos/measure.py
msgid ""
"No timing for this one: it asks for a card to be somewhere this simulator "
"does not model."
msgstr ""
"Pas de timing pour celle-ci : elle demande qu'une carte se trouve à un "
"endroit que ce simulateur ne modélise pas."

#: combos/measure.py
msgid ""
"No timing for this one: it is more than one card away once this deck is read"
" our way."
msgstr ""
"Pas de timing pour celle-ci : il lui manque plus d'une carte une fois ce "
"deck lu à notre façon."

#: combos/measure.py
msgid ""
"No timing for this one: it is one this deck turns out not to hold, once it "
"is read our way."
msgstr ""
"Pas de timing pour celle-ci : ce deck ne la contient finalement pas, une "
"fois lu à notre façon."

#: combos/measure.py
msgid ""
"No timing for this one: it was not among the most-played few this run had "
"room to measure."
msgstr ""
"Pas de timing pour celle-ci : elle ne faisait pas partie des quelques combos"
" les plus jouées que cette simulation avait la place de mesurer."

