msgstr "ID di stampa Scryfall"

#: decks/importers/columns.py
msgid "finish"
msgstr "finitura"

#: decks/importers/columns.py
msgid "condition"
msgstr "condizione"

#: decks/importers/columns.py
msgid "language"
msgstr "lingua"

#: decks/importers/columns.py
msgid "tags or category"
msgstr "tag o categoria"

#: decks/importers/columns.py
#, python-format
msgid "this file has no %(column)s column."
msgstr "questo file non ha la colonna %(column)s."

#: decks/importers/columns.py
#, python-format
msgid "Re-export it with %(header)s included."
msgstr "Esportalo di nuovo includendo %(header)s."

#: decks/importers/tabular.py
msgid "CSV or TSV export (any tool)"
msgstr "Esportazione CSV o TSV (qualsiasi strumento)"

#: decks/importers/tabular.py
msgid ""
"Nothing can be read from a file with no card name in it. Re-export it with "
"the card name included, or map a column to it by hand."
msgstr ""
"Da un file senza nomi di carte non si può leggere nulla. Esportalo di nuovo "
"includendo il nome della carta, oppure assegna a mano una colonna."

#: decks/importers/tabular.py
msgid ""
"Re-export it with Quantity ticked - without it every card would be read as a "
"single copy, and a 28-Swamp deck would import as a 28-card deck with one "
"Swamp in it. You can also map the column by hand."
msgstr ""
"Esportalo di nuovo con Quantity spuntato: senza, ogni carta verrebbe letta "
"come una copia sola, e un deck con 28 Swamp verrebbe importato come un deck "
"da 28 carte con un solo Swamp. Puoi anche assegnare la colonna a mano."

#: decks/importers/tabular.py
#, python-format
msgid ""
"that file has more than %(limit)s card rows. The largest real collection "
"export is a few thousand, so this is almost certainly not a deck list."
msgstr ""
"quel file ha più di %(limit)s righe di carte. La più grande esportazione di "
"collezione reale ne ha qualche migliaio, quindi quasi certamente non è una "
"lista di un deck."

#: decks/importers/tabular.py
#, python-format
msgid "that file is not valid CSV: %(error)s"
msgstr "quel file non è un CSV valido: %(error)s"

#: decks/importers/tabular.py
msgid ""
"that file is not a table - no line in it splits into columns consistently. "
"If it is a plain list of card names, choose 'Plain text list' as the format."
msgstr ""
"quel file non è una tabella: nessuna riga si divide in colonne in modo "
"coerente. Se è una semplice lista di nomi di carte, scegli “Lista di testo "
"semplice” come formato."

#: decks/importers/text.py
msgid "Plain text list (one card per line)"
msgstr "Lista di testo semplice (una carta per riga)"

#: decks/resolve.py
msgid "matched on the exact printing"
msgstr "trovata con la stampa esatta"

#: decks/resolve.py
msgid "matched on the card id"
msgstr "trovata con l'ID della carta"

#: decks/resolve.py
msgid "matched on the exact name"
msgstr "trovata con il nome esatto"

#: decks/resolve.py
msgid "matched on the name, ignoring accents and punctuation"
msgstr "trovata con il nome, ignorando accenti e punteggiatura"

#: decks/resolve.py
msgid "not found"
msgstr "non trovata"

#: decks/resolve.py
msgid "the quantity is more than any collection holds"
msgstr "la quantità supera quella di qualsiasi collezione"

#: decks/resolve.py
msgid "the row has no card name"
msgstr "la riga non ha un nome di carta"

#: decks/resolve.py
msgid "no card with this name, and the printing id is not in the catalogue"
msgstr "nessuna carta con questo nome, e l'ID di stampa non è nel catalogo"

#: decks/resolve.py
msgid "no card with this name in the catalogue"
msgstr "nessuna carta con questo nome nel catalogo"

#: decks/services.py
#, python-format
msgid "file is %(size)s KB; the limit is %(limit)s KB"
msgstr "il file pesa %(size)s KB; il limite è %(limit)s KB"

#: decks/services.py
msgid "that is not a text file - it contains binary data"
msgstr "non è un file di testo: contiene dati binari"

#: decks/services.py
msgid "could not decode the file as text"
msgstr "impossibile decodificare il file come testo"

#: decks/services.py
#, python-format
msgid ""
"file has about %(rows)s lines; the limit is %(limit)s. That is far more than "
"a deck or a collection - is it the right file?"
msgstr ""
"il file ha circa %(rows)s righe; il limite è %(limit)s. È molto più di un "
"deck o di una collezione: è il file giusto?"

#: decks/services.py
msgid "the file contained no card rows"
msgstr "il file non conteneva righe di carte"

#: decks/services.py
msgid "that deck belongs to someone else"
msgstr "quel deck appartiene a qualcun altro"

#: decks/services.py
msgid "Imported deck"
msgstr "Deck importato"

#: decks/services.py
msgid "no parser recognised this file"
msgstr "nessun parser ha riconosciuto questo file"

#: decks/views.py
msgid ""
"Choose a column above for each of card name and quantity - or say the file "
"has not got one - and your own rows will appear here."
msgstr ""
"Scegli qui sopra una colonna per il nome della carta e una per la quantità "
"(oppure indica che il file non ce l'ha) e qui compariranno le tue righe."

#: decks/views.py
msgid ""
"That file was not recognised, so nothing has been assumed about it. Choose "
"“CSV or TSV export (any tool)” as the format and you will be asked which "
"column is which - it takes about thirty seconds and works for any export. "
"Choose “Plain text list” if it is simply one card name per line."
msgstr ""
"Quel file non è stato riconosciuto, quindi non è stato dato nulla per "
"scontato. Scegli “Esportazione CSV o TSV (qualsiasi strumento)” come formato "
"e ti verrà chiesto quale colonna è quale: ci vogliono circa trenta secondi e "
"funziona con qualsiasi esportazione. Scegli “Lista di testo semplice” se è "
"solo un nome di carta per riga."

#: decks/views.py
#, python-format
msgid "Imported %(rows)s row into %(deck)s."
msgid_plural "Imported %(rows)s rows into %(deck)s."
msgstr[0] "Importata %(rows)s riga in %(deck)s."
msgstr[1] "Importate %(rows)s righe in %(deck)s."

#: decks/views.py
#, python-format
msgid ""
"%(missing)s of %(rows)s row could not be matched. Nothing was dropped - it "
"is listed below."
msgid_plural ""
"%(missing)s of %(rows)s rows could not be matched. Nothing was dropped - "
"they are listed below."
msgstr[0] ""
"Riga non abbinata: %(missing)s di %(rows)s. Non è stato scartato nulla: è "
"elencata qui sotto."
msgstr[1] ""
"Righe non abbinate: %(missing)s di %(rows)s. Non è stato scartato nulla: "
"sono elencate qui sotto."

#: decks/views.py
msgid "That card is not in this deck."
msgstr "Quella carta non è in questo deck."

#: decks/views.py
#, python-format
msgid "%(card)s is now the commander."
msgstr "%(card)s ora è il comandante."

