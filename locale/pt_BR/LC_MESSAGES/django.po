msgstr "Planeswalker"

msgid ""
"<strong>Paid plans start soon.</strong> For now everyone is on the free "
"plan."
msgstr ""
"<strong>Os planos pagos começam em breve.</strong> Por enquanto, todos estão"
" no plano gratuito."

