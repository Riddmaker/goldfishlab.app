msgstr "sim"

#: simulations/engine/adapter.py simulations/provenance.py
msgid "no"
msgstr "não"

#: simulations/engine/adapter.py
#, python-format
msgid "1 %(color)s (as a basic land)"
msgstr "1 %(color)s (como terreno básico)"

#: simulations/engine/adapter.py
#, python-format
msgid "%(mana)s - once, then it stays tapped"
msgstr "%(mana)s – uma vez, depois fica virado"

#: simulations/engine/adapter.py
msgid "nothing beyond tapping"
msgstr "nada além de virar"

#: simulations/engine/adapter.py
#, python-format
msgid "one %(color)s for each %(subtype)s you control"
msgstr "um %(color)s para cada %(subtype)s que você controla"

#: simulations/engine/adapter.py
#, python-format
msgid "one extra %(color)s whenever a %(subtype)s is tapped"
msgstr "um %(color)s extra sempre que um %(subtype)s é virado"

#: simulations/engine/adapter.py
#, python-format
msgid "makes every land a %(subtype)s"
msgstr "torna todo terreno um %(subtype)s"

#: simulations/engine/adapter.py
#, python-format
msgid "for %(cost)s, %(mana)s"
msgstr "por %(cost)s, %(mana)s"

#: simulations/engine/adapter.py
#, python-format
msgid ""
"makes one of %(colors)s; the engine cannot hold a choice and reads it as "
"%(color)s"
msgstr ""
"produz uma de %(colors)s; o motor não guarda uma escolha e lê como %(color)s"

#: simulations/engine/adapter.py
msgid "no one said how early to cast it; the default rule applies"
msgstr "ninguém disse quão cedo conjurá-lo; vale a regra padrão"

#: simulations/engine/adapter.py
msgid "makes mana, but how much could not be read"
msgstr "produz mana, mas não foi possível ler quanto"

#: simulations/engine/adapter.py
msgid "a land that taps for nothing the engine can see"
msgstr "um terreno que vira para nada que o motor consiga ver"

#: simulations/forms.py
#, python-format
msgid "%(games)s games - quick look"
msgstr "%(games)s partidas – olhada rápida"

#: simulations/forms.py
#, python-format
msgid "%(games)s games - the usual answer"
msgstr "%(games)s partidas – a resposta usual"

#: simulations/forms.py
#, python-format
msgid "%(games)s games - for small differences"
msgstr "%(games)s partidas – para diferenças pequenas"

#: simulations/forms.py
#, python-format
msgid "%(games)s game"
msgid_plural "%(games)s games"
msgstr[0] "%(games)s partida"
msgstr[1] "%(games)s partidas"

#: simulations/forms.py
#, python-format
