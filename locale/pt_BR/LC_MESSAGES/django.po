#: cards/profiles.py
msgid "enters tapped only conditionally ('unless')"
msgstr "entra virado só sob condição (“a menos que”)"

#: cards/profiles.py
msgid "text mentions entering tapped, but the condition was not readable"
msgstr "o texto fala em entrar virado, mas a condição não pôde ser lida"

#: cards/profiles.py
msgid "a mana ability with a coloured cost (a filter) is not modelled"
msgstr "uma habilidade de mana com custo colorido (um filtro) não é modelada"

#: cards/profiles.py
msgid "makes a kind of mana the engine does not model"
msgstr "produz um tipo de mana que o motor não modela"

#: cards/profiles.py
msgid "the part of its mana that grows with the board is not counted"
msgstr "a parte da mana que cresce com o campo de batalha não é contada"

#: cards/profiles.py
msgid "mana amount scales with the board"
msgstr "a quantidade de mana cresce com o campo de batalha"

#: cards/profiles.py
msgid "a conditional replacement ('instead') is not counted"
msgstr "uma substituição condicional (“em vez disso”) não é contada"

#: cards/profiles.py
msgid "needs an opponent's lands; a goldfish has none"
msgstr "precisa dos terrenos de um oponente; um goldfish não tem nenhum"

#: cards/profiles.py
msgid "an 'Add' clause whose amount could not be read"
msgstr "uma cláusula “Adicione” cuja quantidade não pôde ser lida"

#: cards/profiles.py
msgid "makes mana only from a triggered or static ability"
msgstr "produz mana só por uma habilidade desencadeada ou estática"

#: cards/profiles.py
msgid "makes mana only as part of another effect"
msgstr "produz mana só como parte de outro efeito"

#: cards/profiles.py
msgid "its mana is restricted to certain spells or moments"
msgstr "sua mana é restrita a certas mágicas ou momentos"

#: cards/profiles.py
msgid "enters only by discarding a land card, which the engine does not do"
msgstr "só entra descartando um card de terreno, o que o motor não faz"

#: cards/profiles.py
msgid "only grants a mana ability to another permanent"
msgstr "só concede uma habilidade de mana a outra permanente"

#: cards/profiles.py
msgid "produces mana, but no readable 'Add' clause"
msgstr "produz mana, mas sem cláusula “Adicione” legível"

#: cards/profiles.py
msgid "an ability that only converts mana is not modelled"
msgstr "uma habilidade que só converte mana não é modelada"

#: cards/profiles.py
msgid "sacrifices itself for mana, which is not modelled on a creature"
msgstr "sacrifica a si mesma por mana, o que não é modelado numa criatura"

#: cards/profiles.py
msgid "its mana ability costs as much as it makes"
msgstr "sua habilidade de mana custa tanto quanto produz"

#: cards/profiles.py
msgid "searches the library more than once; not modelled"
msgstr "procura no grimório mais de uma vez; não modelado"

#: cards/profiles.py
msgid "tutors, but no readable 'search your library' clause"
msgstr "é tutor, mas sem cláusula “procure em seu grimório” legível"

#: cards/profiles.py
msgid "tutors, but to which zone could not be read"
msgstr "é tutor, mas não foi possível ler para qual zona"

#: cards/profiles.py
msgid "tutors to more than one zone; not modelled"
msgstr "é tutor para mais de uma zona; não modelado"

#: cards/profiles.py
msgid "tutors onto the battlefield, which the engine cannot do"
msgstr "é tutor direto para o campo de batalha, o que o motor não sabe fazer"

#: cards/profiles.py
msgid "tutors for something the engine cannot describe"
msgstr "é tutor de algo que o motor não consegue descrever"

#: cards/profiles.py
msgid "tutors for more than one card kind; not modelled"
msgstr "é tutor de mais de um tipo de card; não modelado"

#: cards/profiles.py
msgid "searches, then discards at random; the discard is not modelled"
msgstr "procura e depois descarta aleatoriamente; o descarte não é modelado"

#: cards/profiles.py
msgid "tutors, but how many cards it finds could not be read"
msgstr "é tutor, mas não foi possível ler quantos cards encontra"

#: cards/profiles.py
msgid "tagged as adding more than one mana; only one was read"
msgstr "marcada como adicionando mais de uma mana; só uma foi lida"

#: cards/profiles.py
msgid "has an additional casting cost the engine does not pay"
msgstr "tem um custo adicional de conjuração que o motor não paga"

#: cards/profiles.py
msgid "hybrid pips: payment flexibility is not modelled"
msgstr "símbolos híbridos: a flexibilidade de pagamento não é modelada"

#: cards/profiles.py
msgid "cost contains X"
msgstr "o custo contém X"

#: combos/measure.py
msgid ""
"No timing for this one: it needs a kind of card rather than a named one, "
